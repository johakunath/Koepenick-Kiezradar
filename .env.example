# Ingestion runs in GitHub Actions. Set these as repository secret / variable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional manual trigger, only in Vercel production (never NEXT_PUBLIC_*).
# Fine-grained GitHub token scoped to this repository, Actions: write.
GITHUB_TOKEN=
# A separate random secret of at least 32 characters. Without it the route is disabled.
ADMIN_INGEST_SECRET=
